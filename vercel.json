{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "adalintech.com" }],
      "destination": "https://adalintechnologies.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.adalintech.com" }],
      "destination": "https://adalintechnologies.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.adalintechnologies.com" }],
      "destination": "https://adalintechnologies.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "adalintech.com" }],
      "destination": "https://adalintechnologies.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.adalintech.com" }],
      "destination": "https://adalintechnologies.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.adalintechnologies.com" }],
      "destination": "https://adalintechnologies.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/blog", "destination": "/api/blog-index" },
    { "source": "/blog/:slug", "destination": "/api/blog-post?slug=:slug" }
  ]
}
